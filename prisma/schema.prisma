generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id               Int        @id @default(autoincrement())
  nome             String
  obreiro          String
  lideranca        String
  membro           Boolean    @default(true)
  casalArticulador Boolean    @default(false)
  congregacao      String
  dataCadastro     DateTime   @default(now())
  presencas        Presenca[]
}

model HistoricoChamada {
  id        String     @id @default(uuid())
  data      DateTime   @default(now())
  evento    String
  presencas Presenca[]
}

model Presenca {
  id          Int              @id @default(autoincrement())
  status      String
  pessoaId    Int
  historicoId String
  historico   HistoricoChamada @relation(fields: [historicoId], references: [id], onDelete: Cascade)
  pessoa      Pessoa           @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
}

model Aviso {
  id        String   @id @default(uuid())
  texto     String
  imagem    String?
  cor       String   @default("#000000")
  bg        String   @default("#ffffff")
  data      String
  createdAt DateTime @default(now())
}

model Aniversario {
  id               Int      @id @default(autoincrement())
  nome             String
  dataNascimento   String   
  genero           String   
  nomeConjuge      String?
  dataNascConjuge  String?
  dataCasamento    String?
  fotoUrl          String?// Foto do Titular
  fotoConjugeUrl   String? // Foto do Cônjuge
  fotoCasamentoUrl String? // Foto do Casal
  createdAt        DateTime @default(now())
}